{
  "repository_type": "monorepo",
  "primary_language": "TypeScript",
  "parts": [
    {
      "part_id": "backend",
      "display_name": "Backend",
      "project_type_id": "backend",
      "root_path": "backend/",
      "stack": {
        "runtime": "Node.js 20",
        "language": "TypeScript 5.9 (strict: false)",
        "framework": "Express 5",
        "datastore": "MongoDB 7 (per-service database)",
        "real_time": "AWS SNS (cloud) / Redis Pub/Sub (local)",
        "lambda_adapter": "@codegenie/serverless-express",
        "iac": "AWS SAM",
        "edge_local": "Nginx 1.27"
      },
      "services": [
        { "name": "user-service", "owns": ["users"] },
        { "name": "room-service", "owns": ["rooms", "roomassociations"] },
        { "name": "character-service", "owns": ["characters"], "publishes": ["character_created", "character_updated", "character_deleted"] },
        { "name": "battle-service", "owns": ["battles"], "publishes": ["battle_started", "battle_updated", "battle_concluded", "battle_discarded"] },
        { "name": "log-service", "owns": ["logevents"], "exposes": ["GET /logs", "GET /logs/:logId"] },
        { "name": "room-notifications-service", "owns": ["roomconnections"], "exposes": ["WS /ws"] }
      ]
    },
    {
      "part_id": "frontend",
      "display_name": "Frontend",
      "project_type_id": "mobile",
      "root_path": "frontend/",
      "stack": {
        "runtime": "Node.js 24+ (dev)",
        "language": "TypeScript 5.9 (strict: true)",
        "framework": "Expo 55 + Expo Router 55",
        "ui": "React 19.2 + React Native 0.83.2",
        "server_state": "@tanstack/react-query 5",
        "schema_validation": "zod 4",
        "tests": "Vitest 4 + Testing Library RN + jsdom",
        "e2e": "Maestro",
        "delivery": "Fastlane (Match, deliver, supply)"
      },
      "platforms": ["iOS", "Android", "Web"]
    },
    {
      "part_id": "infrastructure",
      "display_name": "Infrastructure",
      "project_type_id": "infra",
      "root_path": "infrastructure/",
      "stack": {
        "iac": "Pulumi 3.203.0 (TypeScript)",
        "provider": "@pulumi/aws 7.10.0",
        "resources": ["S3 (private bucket)", "CloudFront (OAC)", "Route 53 (A + AAAA)", "ACM (us-east-1, looked up)"]
      },
      "owns": ["frontend hosting"]
    }
  ],
  "integration_points": [
    {
      "from": "frontend",
      "to": "backend",
      "type": "REST",
      "details": [
        "/users (user-service)",
        "/rooms, /rooms/associations (room-service)",
        "/characters, /characters/:id (character-service)",
        "/battles, /battles/:id, /battles/:id/conclude (battle-service)",
        "/logs, /logs/:logId (log-service)"
      ]
    },
    {
      "from": "frontend",
      "to": "backend",
      "type": "WebSocket",
      "details": ["/ws?roomId=&userId= (room-notifications-service)"]
    },
    {
      "from": "room-service",
      "to": "character-service",
      "type": "REST (internal)",
      "details": ["axios POST /characters with CHARACTER_CALL_TIMEOUT_MS"]
    },
    {
      "from": "character-service",
      "to": "room-notifications-service",
      "type": "Pub/Sub",
      "details": ["SNS topic room-character-events (cloud) or Redis channel room-character-events (local)"]
    },
    {
      "from": "character-service",
      "to": "log-service",
      "type": "Pub/Sub",
      "details": ["SNS topic log-events (cloud) or Redis channel room-log-events (local)"]
    },
    {
      "from": "battle-service",
      "to": "room-notifications-service",
      "type": "Pub/Sub",
      "details": ["Same room-character-events topic (cloud) or channel (local). Battle notifications travel through the same fanout as character notifications."]
    },
    {
      "from": "battle-service",
      "to": "log-service",
      "type": "Pub/Sub",
      "details": ["log-events topic (cloud) / room-log-events channel (local). Restricted to lifecycle events: battle_started, battle_concluded, battle_discarded."]
    },
    {
      "from": "infrastructure",
      "to": "backend",
      "type": "CloudFormation outputs",
      "details": ["aws.cloudformation.getStack({ name: 'munch-helper-user-service' }) outputs ApiBaseUrl + WebSocketApiUrl, used as CloudFront origin domain names."]
    },
    {
      "from": "infrastructure",
      "to": "frontend",
      "type": "Static asset upload",
      "details": ["Pulumi uploads each file under frontend/dist as a BucketObjectv2 with MIME-derived contentType and path-derived cacheControl."]
    }
  ]
}
