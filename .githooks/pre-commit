#!/usr/bin/env sh

set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! git diff --cached --name-only | grep -q '^frontend/'; then
  echo "Skipping mobile E2E: no staged frontend changes."
  exit 0
fi

echo "Running mobile E2E: staged frontend changes detected."
exec npm run test:e2e:mobile
