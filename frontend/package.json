{
  "name": "munch-helper",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "lint": "expo lint",
    "tsc": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:room-route",
    "test:unit": "vitest run",
    "test:room-route": "vitest run -c vitest.room-route.config.ts",
    "test:coverage": "vitest run --coverage && npm run test:room-route",
    "test:watch": "vitest --exclude \"__tests__/app/**/*.test.{ts,tsx}\"",
    "maestro": "maestro test ../maestro/character_removal.yaml",
    "maestro:all": "maestro test ../maestro/",
    "maestro:record": "maestro record --local ../maestro/character_removal.yaml ../maestro-recordings/character_removal.mp4",
    "maestro:all:record": "maestro record --local ../maestro/ ../maestro-recordings/all_flows.mp4",
    "prebuild:clean": "node ./scripts/prebuild-clean.mjs"
  },
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~57.0.8",
    "expo-checkbox": "~57.0.0",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "reanimated-color-picker": "^4.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.10",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "jsdom": "^28.1.0",
    "react-test-renderer": "^19.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  },
  "private": true
}
